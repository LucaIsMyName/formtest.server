{
  "name": "formtest-server",
  "version": "1.0.88",
  "description": "Donation form testing application with Electron, Vite, TypeScript, and Playwright",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "npm run generate-docs && electron-vite dev",
    "build": "npm run generate-docs && electron-vite build && npm run copy-runner",
    "generate-docs": "node scripts/generate-docs.js",
    "copy-runner": "mkdir -p out/main/testRunner && cp src/main/testRunner/runner.js src/main/testRunner/scriptExecutor.js src/main/testRunner/seoAnalyzer.js src/main/testRunner/accessibilityAnalyzer.js out/main/testRunner/",
    "preview": "electron-vite preview",
    "pack": "electron-builder",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder --mac --win --linux",
    "generate-icons": "electron-icon-builder --input=./build/icons/logo.jpg --output=./build/icons --flatten && mv build/icons/icons/icon.icns build/icons/ 2>/dev/null || true && mv build/icons/icons/icon.ico build/icons/ 2>/dev/null || true && cp build/icons/icons/512x512.png build/icons/icon.png 2>/dev/null || true",
    "postinstall": "electron-builder install-app-deps && npm run rebuild:sqlite && npx playwright install chromium",
    "test": "npm rebuild better-sqlite3 && vitest run && npm run rebuild:sqlite",
    "test:quick": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:e2e": "npm run build && playwright test --config=e2e/playwright.config.ts",
    "test:e2e:headed": "npm run build && playwright test --config=e2e/playwright.config.ts --headed",
    "rebuild:sqlite": "electron-rebuild -f -w better-sqlite3"
  },
  "keywords": [
    "electron",
    "vite",
    "typescript",
    "donation",
    "form-testing",
    "playwright"
  ],
  "author": "Luca",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@faker-js/faker": "^10.1.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^4.0.13",
    "autoprefixer": "^10.4.16",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-icon-builder": "^2.0.1",
    "electron-vite": "^2.0.0",
    "eslint": "^8.54.0",
    "jsdom": "^27.2.0",
    "playwright": "^1.57.0",
    "postcss": "^8.4.32",
    "react-scan": "^0.4.3",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^4.0.13"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/prismjs": "^1.26.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "better-sqlite3": "^9.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "keytar": "^7.9.0",
    "lucide-react": "^0.554.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.11",
    "prismjs": "^1.30.0",
    "react": "^18.2.0",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.20.0",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "^3.5.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "zustand": "^4.4.7"
  },
  "build": {
    "appId": "com.formtest.server",
    "productName": "FormTest Server",
    "copyright": "Copyright © 2026 LucaIsMyName",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!node_modules/*.d.ts",
      "!node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "extraResources": [
      {
        "from": "out/main/testRunner/",
        "to": "testRunner/"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icons/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "FormTest Server ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "build/icons/icon.ico",
      "publisherName": "Luca"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FormTest Server"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/icon.png",
      "category": "Development"
    },
    "publish": null
  }
}
